{
  "version": "1.0",
  "createdAt": "2026-07-11",
  "demoId": "DI",
  "demoName": "DI-three-bubble-reveal",
  "displayName": "DI | Three Bubble Reveal",
  "path": "LIST_demo/demos/DI-three-bubble-reveal",
  "url": "http://localhost:5178/",
  "port": 5178,
  "startCommand": "cd LIST_demo && npm run demo:di",
  "purpose": "DF Three.js 空間に Bubble Color Reveal を統合し、白黒空間内の円形カラー復帰体験を検証する",
  "baseDemo": "DF-three-camera-depth",
  "dfBodyModified": false,
  "canvasCount": 1,
  "verdict": "条件付き合格",
  "verdictReason": [
    "体験としてカラー復帰・カメラ・Raycaster/ZOOM が成立",
    "本番前にレンダラ確定・タッチ本仕様・実機サイズ調整が必要"
  ],
  "dependencies": {
    "three": "^0.172.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "framer-motion": "^11.15.0"
  },
  "feelSummary": [
    "DFカメラ操作は維持",
    "Bubble追従は自然（smoothingやや遅れ）",
    "カラー復帰は一目で成立",
    "Raycaster/IMAGE_ZOOMは壊れていない",
    "FPS悪化は限定的（環境依存）"
  ],
  "inheritedFromDf": [
    "PerspectiveCamera",
    "FogExp2",
    "WebGLRenderer 1 canvas",
    "Plane Mesh + Texture ~70",
    "Raycaster tap",
    "drag / wheel / dolly cruise",
    "IMAGE_ZOOM",
    "categoryDrawer",
    "Review / Debug",
    "visual preset"
  ],
  "addedInDi": [
    "DOM BubbleOverlay SVG",
    "screen-space reveal shader",
    "bubbleConfig",
    "pointer follow + gates",
    "bubble motion toggle",
    "relaxed tap/hit thresholds"
  ],
  "bubbleConfig": {
    "enabled": true,
    "sizePx": 320,
    "revealRadiusPx": 160,
    "offsetX": 0,
    "offsetY": 0,
    "followSmoothing": 0.18,
    "hideDelayMs": 600,
    "showOnPointerMove": true,
    "activeOnlyInList": true,
    "revealMode": "shader"
  },
  "bubbleMotion": {
    "default": "elegant",
    "presets": ["off", "elegant"],
    "elegant": {
      "breathPeriodSec": 3.6,
      "breathScalePeak": 1.028,
      "glintOrbitPeriodSec": 7.5,
      "glintCount": 2,
      "glintPlacement": "opposite on circumference",
      "glintShape": "tangent-aligned soft ellipse",
      "trail": false,
      "dustNearEachGlint": true,
      "dustCountApprox": 5
    }
  },
  "domBubbleStructure": {
    "root": ".bubble-overlay",
    "pointerEvents": "none",
    "position": "fixed screen",
    "svg": true,
    "cssAnimation": true,
    "framerMotionOnBubble": false,
    "children": [
      "circle.base (thin stroke)",
      "g.glint-orbit (rotates 7.5s)",
      "ellipse glint A + dust",
      "ellipse glint B opposite + dust"
    ]
  },
  "colorReveal": {
    "technique": "MeshBasicMaterial.onBeforeCompile screen-space mix",
    "grayscale": "luma 0.299/0.587/0.114",
    "radiusSpace": "screen-px (CSS × pixelRatio → drawing buffer)",
    "centerPipeline": "smoothed client → canvas rect → NDC → uRevealCenterNdc",
    "sharedUniforms": [
      "uRevealCenterNdc",
      "uRevealRadiusPx",
      "uResolution",
      "uRevealActive"
    ],
    "edgeSoftnessPx": 1.0,
    "multiPlaneBehavior": "same screen circle applies to all visible meshes",
    "rejectedApproaches": ["dom-clip-path", "dual-plane", "raycaster-world-circle"],
    "whyShader": [
      "extends DF grayscale path",
      "no mesh count increase",
      "constant screen radius under camera move",
      "stable vs DF interactions"
    ]
  },
  "tap": {
    "maxMovePx": 16,
    "maxDurationMs": 600,
    "hitTestMinAlpha": 0.1,
    "dfComparison": {
      "maxMovePx": 12,
      "maxDurationMs": 500,
      "hitTestMinAlpha": 0.18
    },
    "method": "pointerup → Raycaster",
    "bubbleBlocksPointer": false
  },
  "gates": {
    "bubbleAllowed": "!imageZoomOpen && !drawerOpen && bubbleConfig.enabled",
    "reviewModeShowsBubble": true,
    "reviewModeHidesDebug": true
  },
  "pointerBehavior": {
    "pointermove": "bubble follow + reveal center",
    "pointerdown": "show bubble; keep DF drag/tap",
    "pointerup": "hide after hideDelayMs",
    "pointerleave": "schedule hide",
    "drag": "coexists; camera pan unchanged",
    "wheel": "unchanged DF dolly/scrub"
  },
  "debugPanelBubbleFields": [
    "bubbleEnabled",
    "bubbleVisible",
    "bubbleAllowed",
    "bubbleMotion",
    "bubbleScreenX",
    "bubbleScreenY",
    "bubbleSizePx",
    "revealRadiusPx",
    "revealMode",
    "pointerType",
    "imageZoomOpen",
    "drawerOpen",
    "revealActive",
    "revealCenterNdc"
  ],
  "performanceNotes": {
    "targetFps": "~60",
    "imageCount": 70,
    "canvasCount": 1,
    "meshApprox": 70,
    "textureApprox": 70,
    "bubbleLoadDelta": "small (shared uniforms + DOM/SVG)",
    "contextLostHandler": "thin (same as DF)"
  },
  "knownIssues": [
    "touch production gestures not implemented",
    "hideDelay after pointerup is PC review heuristic",
    "followSmoothing lag is intentional but noticeable",
    "onBeforeCompile brittle across Three upgrades",
    "no billboard (DF inheritance)",
    "sequential texture load wait",
    "PRODUCT_DETAIL not wired",
    "no 4-monitor sync / 10min sleep",
    "edgeAutoPan not implemented"
  ],
  "productionPortNotes": {
    "reuse": [
      "screen-space reveal concept",
      "DOM bubble + pointer-events none",
      "bubbleConfig semantics",
      "ZOOM/drawer gates"
    ],
    "rewrite": [
      "wire to production screenState",
      "assetIndex / getContentFileUrl",
      "Pixi path if LIST renderer is Pixi"
    ],
    "connections": {
      "screenState": "PRODUCT_LIST only",
      "idle10min": "disable bubble on TOP return",
      "fourMonitorSync": "bubble stays local per window",
      "categoryDrawer": "disable while open",
      "imageZoom": "disable while open",
      "trunkLogo": "unrelated"
    }
  },
  "keyFiles": {
    "new": [
      "src/bubbleConfig.ts",
      "src/three/bubbleRevealShader.ts",
      "src/ui/BubbleOverlay.tsx"
    ],
    "extended": [
      "src/three/exploreController.ts",
      "src/App.tsx",
      "src/ui/DebugPanel.tsx",
      "src/ui/DemoToggles.tsx",
      "src/styles.css",
      "src/types.ts",
      "src/three/sceneLayout.ts"
    ],
    "listDemoWiring": [
      "LIST_demo/package.json",
      "LIST_demo/README.md"
    ]
  },
  "relatedDocs": [
    "LIST_demo/reports/bubble-color-reveal-spec.md",
    "LIST_demo/reports/DF-three-camera-depth-implementation-report.md",
    "LIST_demo/reports/DE-vs-DF-comparison-report.md"
  ],
  "scopeOfThisDocument": {
    "includes": ["documentation only"],
    "excludes": [
      "app/ changes",
      "DF body changes",
      "DE/DD/DB/DA changes",
      "new features",
      "PRODUCT_DETAIL",
      "4-monitor sync",
      "productionization"
    ]
  }
}
