flowchart TD
  %% 画面遷移図（正: docs/function.xlsx → docs/screen-flow.json）
  %% B案：探索デザイン重視型

  subgraph TOP_AREA["TOP スリープ画面（4面同期）"]
    direction LR
    P1["panel-1"]
    P2["panel-2"]
    P3["panel-3"]
    P4["panel-4"]
  end

  ANIMATION["ANIMATION\nアニメーション_1"]
  PRODUCT_LIST["PRODUCT_LIST\n探索画面\n+ categoryDrawer"]
  PRODUCT_DETAIL["PRODUCT_DETAIL\n詳細画面\nscrollSection"]
  IMAGE_ZOOM["IMAGE_ZOOM\n画像拡大 overlay"]

  TOP_AREA -->|指定箇所タップ・4面同期| ANIMATION
  ANIMATION -->|自動遷移・4面同期| PRODUCT_LIST

  PRODUCT_LIST -->|カテゴリ選択・各台独立| PRODUCT_DETAIL
  PRODUCT_DETAIL -->|×・各台独立| PRODUCT_LIST
  PRODUCT_DETAIL -->|画像タップ・各台独立| IMAGE_ZOOM
  IMAGE_ZOOM -->|×→常に LIST・各台独立| PRODUCT_LIST

  PRODUCT_LIST -->|ロゴタップ| TOP_AREA
  PRODUCT_DETAIL -->|ロゴタップ| TOP_AREA
  IMAGE_ZOOM -->|ロゴタップ| TOP_AREA

  classDef top fill:#fff4b8,stroke:#c9b94a,stroke-width:1px,color:#222;
  classDef animation fill:#cfe3ff,stroke:#6a9bd8,stroke-width:1px,color:#222;
  classDef explore fill:#fff4b8,stroke:#c9b94a,stroke-width:1px,color:#222;
  classDef detail fill:#fff4b8,stroke:#c9b94a,stroke-width:1px,color:#222;
  classDef zoom fill:#ffffff,stroke:#777,stroke-width:1px,color:#222;

  class P1,P2,P3,P4 top;
  class ANIMATION animation;
  class PRODUCT_LIST explore;
  class PRODUCT_DETAIL detail;
  class IMAGE_ZOOM zoom;
