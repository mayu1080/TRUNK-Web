flowchart TD
  %% 画面遷移図（正: Design_Check0622.mp4 → docs/screen-flow.json）
  %% B案：探索デザイン重視型

  subgraph TOP_AREA["TOP スリープ画面"]
    direction LR
    P1["panel-1"]
    P2["panel-2"]
    P3["panel-3"]
    P4["panel-4"]
  end

  ANIMATION["ANIMATION\nアニメーション_1"]
  PRODUCT_LIST["PRODUCT_LIST\n暗色探索画面\n+ categoryDrawer"]
  IMAGE_ZOOM["IMAGE_ZOOM\n白 overlay/card"]
  PRODUCT_DETAIL["PRODUCT_DETAIL\n白詳細/カルーセル"]

  TOP_AREA -->|全台TOP時タップ・4面同期| ANIMATION
  ANIMATION -->|自動遷移・4面同期| PRODUCT_LIST

  PRODUCT_LIST -->|画像タップ・各台独立| IMAGE_ZOOM
  IMAGE_ZOOM -->|×→常に LIST・各台独立| PRODUCT_LIST

  PRODUCT_LIST -->|categoryDrawer カテゴリ選択・各台独立| PRODUCT_DETAIL
  PRODUCT_DETAIL -->|×・各台独立| PRODUCT_LIST

  PRODUCT_LIST -->|無操作10分・各台独立| TOP_AREA
  PRODUCT_DETAIL -->|無操作10分・各台独立| TOP_AREA
  IMAGE_ZOOM -->|無操作10分・各台独立| TOP_AREA

  classDef top fill:#fff4b8,stroke:#c9b94a,stroke-width:1px,color:#222;
  classDef animation fill:#cfe3ff,stroke:#6a9bd8,stroke-width:1px,color:#222;
  classDef explore fill:#333333,stroke:#888888,stroke-width:1px,color:#eee;
  classDef detail fill:#ffffff,stroke:#777777,stroke-width:1px,color:#222;
  classDef zoom fill:#ffffff,stroke:#777777,stroke-width:1px,color:#222;

  class P1,P2,P3,P4 top;
  class ANIMATION animation;
  class PRODUCT_LIST explore;
  class PRODUCT_DETAIL detail;
  class IMAGE_ZOOM zoom;
